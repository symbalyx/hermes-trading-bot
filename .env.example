# ═══════════════════════════════════════════════════════════════
# Hermes Trading Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All settings can also be set via environment variables prefixed
# with HERMES_ (e.g., HERMES_EXCHANGE=binance)
#
# Config priority: defaults < config.json < .env < env vars
# ═══════════════════════════════════════════════════════════════

# ─── Exchange ──────────────────────────────────────────────────────
HERMES_EXCHANGE=binance
HERMES_EXCHANGE_MODE=paper
# HERMES_API_KEY=your_api_key_here
# HERMES_API_SECRET=your_api_secret_here

# ─── Trading ───────────────────────────────────────────────────────
HERMES_STAKE_CURRENCY=USDT
HERMES_STAKE_AMOUNT=100
HERMES_MAX_OPEN_TRADES=3
HERMES_DRY_RUN=true
HERMES_DRY_RUN_WALLET=10000

# ─── Strategy ──────────────────────────────────────────────────────
HERMES_STRATEGY=HermesV4
HERMES_TIMEFRAME=1d
HERMES_MIN_SCORE=0.25
HERMES_RISK_PER_TRADE=0.02
HERMES_MAX_DRAWDOWN=0.15
HERMES_STOPLOSS=-0.05
HERMES_TRAILING_STOP=true
HERMES_TRAILING_STOP_POSITIVE=0.01
HERMES_TRAILING_STOP_OFFSET=0.02

# ─── API Server ────────────────────────────────────────────────────
HERMES_API_SERVER_ENABLED=false
HERMES_API_SERVER_PORT=8080
HERMES_API_SERVER_HOST=127.0.0.1

# ─── Notifications (Telegram) ──────────────────────────────────────
HERMES_TELEGRAM_ENABLED=false
# HERMES_TELEGRAM_BOT_TOKEN=your_bot_token
# HERMES_TELEGRAM_CHAT_ID=your_chat_id

# ─── LLM / AI (Ollama) ─────────────────────────────────────────────
HERMES_LLM_ENABLED=false
HERMES_LLM_MODEL=qwen2.5:3b
HERMES_OLLAMA_BASE_URL=http://localhost:11434

# ─── Data ──────────────────────────────────────────────────────────
HERMES_DATA_DIR=data
HERMES_CACHE_TTL=600

# ─── Coin List (comma-separated or JSON array) ─────────────────────
HERMES_COIN_LIST=["bitcoin","ethereum","cardano","solana","ripple"]
